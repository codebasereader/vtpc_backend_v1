server {
    listen 80;
    server_name api.example.gov.in;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name api.example.gov.in;

    # ssl_certificate     /etc/letsencrypt/live/api.example.gov.in/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/api.example.gov.in/privkey.pem;

    # Largest legitimate upload is an 80 MB video; admin JSON is small.
    client_max_body_size 80M;

    # Extra brake on login guessing (the app also rate-limits).
    # In the http {} block: limit_req_zone $binary_remote_addr zone=login:10m rate=10r/m;
    # location = /auth/login { limit_req zone=login burst=5 nodelay; proxy_pass http://127.0.0.1:4200; ... }

    location / {
        # Must match PORT in the API's .env (4200 in .env.example).
        proxy_pass http://127.0.0.1:4200;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite, don't append: a client-supplied X-Forwarded-For must never be trusted.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
