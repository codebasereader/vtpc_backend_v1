NODE_ENV=development
PORT=4200

# Public origin of THIS API — used to build absolute file URLs.
# Locally this MUST use the same port as PORT (file URLs 404 if they differ).
# EC2 / nginx example: https://api.vtpc.karnataka.gov.in
PUBLIC_BASE_URL=http://localhost:4200

# Comma-separated frontend origins (credentials + explicit origin, never *)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

MONGODB_URI=mongodb://127.0.0.1:27017/vtpc

# Long random string. Changing it invalidates every session.
SESSION_SECRET=change-me-to-a-long-random-string

# lax = same-site (frontend + API on *.example.gov.in)
# none = cross-site (frontend on another domain; requires HTTPS)
COOKIE_SAMESITE=lax
COOKIE_NAME=vtpc.sid
# Session lifetime in days
SESSION_DAYS=7

# First admin created by `npm run seed` / `npm run create-admin`
ADMIN_EMAIL=editor@vtpc.gov.in
ADMIN_PASSWORD=change-this-password
ADMIN_NAME=Editor

# Behind nginx / ALB set to 1 so Secure cookies and client IPs work
TRUST_PROXY=0

# Newsletter send (POST /admin/newsletter/issues/:id/send)
# Leave SMTP_HOST empty to disable sending; the endpoint will return 503.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=VTPC <noreply@vtpc.gov.in>
